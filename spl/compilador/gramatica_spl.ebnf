/* GRAMATICA E-BNF DEL COMPILADOR SPL PARA ENIGMA-64 (Bottlecaps RR-UI) */

Programa ::= DeclaracionExterna*
DeclaracionExterna ::= DefinicionTDA | DefinicionTypedef | DeclaracionFuncion | DeclaracionVariable

/* 1. Tipos y TDA */
DefinicionTDA ::= ( 'struct' | 'tda' ) ID '{' CampoTDA+ '}' ';'
CampoTDA ::= EspecificadorTipo ID Dimensiones ';'
DefinicionTypedef ::= 'typedef' EspecificadorTipo ID Dimensiones ';'
EspecificadorTipo ::= 'const'? TipoBase
TipoBase ::= 'int' | 'float' | 'bool' | 'char' | 'void' | ( 'struct' | 'tda' ) ID | TIPO_ID
Dimensiones ::= ( '[' Expresion ']' )*
DimensionesAbiertas ::= ( '[' Expresion? ']' )*

/* 2. Variables: escalares, vectores y matrices; varios declaradores; dimension vacia con inicializador */
DeclaracionVariable ::= EspecificadorTipo Declarador ( ',' Declarador )* ';'
Declarador ::= ID DimensionesAbiertas ( '=' Inicializador )?
Inicializador ::= Expresion | '{' Inicializador ( ',' Inicializador )* ','? '}'

/* 3. Funciones (definicion o prototipo) */
DeclaracionFuncion ::= 'function'? EspecificadorTipo ID '(' ( Parametro ( ',' Parametro )* )? ')' ( Bloque | ';' )
Parametro ::= EspecificadorTipo ID? DimensionesAbiertas

/* 4. Sentencias */
Bloque ::= '{' ElementoBloque* '}'
ElementoBloque ::= DeclaracionVariable | Sentencia
Sentencia ::= Bloque | ';' | SentenciaSimple ';' | SentenciaIf | SentenciaSwitch | SentenciaWhile
            | SentenciaDoWhile | SentenciaFor | SentenciaReturn | SentenciaBreak | SentenciaContinue
SentenciaSimple ::= Expresion ( OpAsignacion Expresion | '++' | '--' )?
OpAsignacion ::= '=' | '+=' | '-=' | '*=' | '/=' | '%=' | '&=' | '|=' | '^=' | '<<=' | '>>='
SentenciaIf ::= 'if' '(' Expresion ')' 'then'? Sentencia ( 'else' Sentencia )?
SentenciaSwitch ::= 'switch' '(' Expresion ')' '{' ClausulaCase* ( 'default' ':' ElementoBloque* )? '}'
ClausulaCase ::= 'case' ConstanteCase ':' ElementoBloque*
ConstanteCase ::= '-'? ( ENTERO_DEC | ENTERO_HEX | ENTERO_BIN ) | CHAR_LITERAL | 'true' | 'false'
SentenciaWhile ::= 'while' '(' Expresion ')' Sentencia
SentenciaDoWhile ::= 'do' Sentencia 'while' '(' Expresion ')' ';'
SentenciaFor ::= 'for' '(' ForInicial ';' Expresion? ';' SentenciaSimple? ')' Sentencia
ForInicial ::= EspecificadorTipo ID ( '=' Expresion )? | SentenciaSimple?
SentenciaReturn ::= 'return' Expresion? ';'
SentenciaBreak ::= 'break' ';'
SentenciaContinue ::= 'continue' ';'

/* 5. Expresiones: 13 niveles de precedencia, asociatividad izquierda */
Expresion ::= ExprOr
ExprOr ::= ExprAnd ( '||' ExprAnd )*
ExprAnd ::= ExprBitOr ( '&&' ExprBitOr )*
ExprBitOr ::= ExprBitXor ( '|' ExprBitXor )*
ExprBitXor ::= ExprBitAnd ( '^' ExprBitAnd )*
ExprBitAnd ::= ExprIgualdad ( '&' ExprIgualdad )*
ExprIgualdad ::= ExprRelacional ( ( '==' | '!=' ) ExprRelacional )*
ExprRelacional ::= ExprShift ( ( '<' | '<=' | '>' | '>=' ) ExprShift )*
ExprShift ::= ExprAditiva ( ( '<<' | '>>' ) ExprAditiva )*
ExprAditiva ::= ExprMultiplicativa ( ( '+' | '-' ) ExprMultiplicativa )*
ExprMultiplicativa ::= ExprUnaria ( ( '*' | '/' | '%' ) ExprUnaria )*
ExprUnaria ::= ( '+' | '-' | '!' | '~' ) ExprUnaria
             | 'sizeof' '(' ( EspecificadorTipo | Expresion ) ')'
             | ExprPostfija
ExprPostfija ::= ExprPrimaria ( '[' Expresion ']' | '.' ID | '(' ( Expresion ( ',' Expresion )* )? ')' )*
ExprPrimaria ::= ID | LiteralConstante | '(' Expresion ')'
LiteralConstante ::= ENTERO_DEC | ENTERO_HEX | ENTERO_BIN | FLOTANTE | STRING | CHAR_LITERAL | 'true' | 'false'

<?TOKENS?>

/* 6. Lexico. Se aplica la coincidencia mas larga; las palabras reservadas tienen prioridad sobre ID:
   struct tda typedef const int float bool char void function if then else switch case default
   while do for return break continue sizeof true false */
ID ::= [a-zA-Z_] [a-zA-Z0-9_]*
TIPO_ID ::= ID  /* mismo patron que ID; el lexer lo emite si el nombre fue declarado con typedef */
ENTERO_DEC ::= [0-9]+
ENTERO_HEX ::= '0' [xX] [0-9a-fA-F]+
ENTERO_BIN ::= '0' [bB] [01]+
FLOTANTE ::= ( [0-9]+ '.' [0-9]* | '.' [0-9]+ ) ( [eE] [+-]? [0-9]+ )? | [0-9]+ [eE] [+-]? [0-9]+
STRING ::= '"' ( [^"\#x0A#x0D] | '\' [ntr0\"'] )* '"'
CHAR_LITERAL ::= "'" ( [^'\#x0A#x0D] | '\' [ntr0\"'] ) "'"

/* Tokens que el analizador descarta */
ESPACIO ::= [#x20#x09#x0A#x0D]+
COMENTARIO_LINEA ::= '//' [^#x0A#x0D]*
COMENTARIO_BLOQUE ::= '/*' ( [^*] | '*'+ [^*/] )* '*'+ '/'
